# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string; Telegram sends it back in every webhook request
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_TELEGRAM_IDS=
