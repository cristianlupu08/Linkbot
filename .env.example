# Copy this file to .env.local and fill in the values. Never commit .env.local.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Any long random string; Telegram sends it back in every webhook request
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot)
ALLOWED_TELEGRAM_IDS=

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# From OpenAI (platform.openai.com -> API keys), used for voice transcription
OPENAI_API_KEY=

# Supabase -> Project Settings -> API Keys: Project URL and a secret key (sb_secret_...)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Secret code for the invite link t.me/<bot>?start=<code>. Leave empty to disable invites.
INVITE_CODE=

# Any long random string; Vercel sends it to the daily reminder job
CRON_SECRET=
